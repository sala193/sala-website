---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    href: '/tools/afford',
    tag: '買房',
    title: '購屋能力試算',
    desc: '從月收入和自備款，反推你大約買得起多少總價，同時檢查月付金負擔與貸款成數。',
  },
  {
    href: '/tools/capgain',
    tag: '賣房',
    title: '房地合一稅試算',
    desc: '依取得日與出售日算出稅率與稅額，支援自住優惠，並提示再持有多久稅率會降。',
  },
];
---
<BaseLayout title="免費試算工具" description="蔡莎拉提供的免費房產試算工具：購屋能力試算、房地合一稅試算，買房賣房先算清楚。">
  <section class="section">
    <div class="container">
      <h1>免費試算工具</h1>
      <p class="section-lead">買房、賣房前先把數字算清楚。工具都是概算，實際條件歡迎直接找蔡莎拉聊。</p>
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        {tools.map((t) => (
          <a class="card" href={t.href}>
            <div class="card-body">
              <div class="card-region">{t.tag}</div>
              <h3>{t.title}</h3>
              <p>{t.desc}</p>
              <span class="card-link">開始試算 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

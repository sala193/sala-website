---
import BaseLayout from '../../layouts/BaseLayout.astro';
import listings from '../../data/listings.json';

export function getStaticPaths() {
  const byId = new Map();
  for (const item of listings) {
    if (!byId.has(item.id)) byId.set(item.id, item);
  }
  return [...byId.values()].map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;

// 法規揭露(依不動產經紀業管理條例第21條第2項):兩間門市的經紀業/經紀人資訊,
// 統一列在每個物件頁面下方。
const LEGAL_DISCLOSURE = [
  {
    storeLabel: '永慶鶯歌建國捷運加盟店',
    lines: ['經紀業：廣輝不動產有限公司', '經紀人：簡梅芳（111）新北經字第003924號'],
  },
  {
    storeLabel: '永慶鶯歌鳳鳴站前加盟店',
    lines: ['經紀業：誠輝不動產有限公司', '經紀人：張捷誠（114）新北經字第004766號'],
  },
];
const AGENT_LINE = '營業員：蔡茹儀（100）登字第181761號';

const images = item.images?.length ? item.images : item.image ? [item.image] : [];

const title = item.name || '待售物件';
const description = `${item.type || ''} ${item.address || ''} ${item.price ? item.price + '萬' : ''}｜蔡莎拉為您服務，歡迎聯繫看屋`.trim();
---

<BaseLayout title={title} description={description}>
  <article class="section">
    <div class="container article-layout">
      <div class="prose" id="galleryRoot" data-images={JSON.stringify(images)}>
        {images.length ? (
          <button type="button" class="hero-btn" data-index="0">
            <img src={images[0]} alt={title} class="community-cover" />
          </button>
        ) : (
          <div class="no-photo-hero">尚無照片</div>
        )}

        <p class="card-region">
          {item.type} {item.address && `．${item.address}`}
        </p>
        <h1>{title}</h1>

        <div class="price-block">
          {item.originalPrice && <span class="price-original">{item.originalPrice} 萬</span>}
          <span class="price">{item.price ? `${item.price} 萬` : '價格洽詢'}</span>
        </div>

        {images.length > 1 && (
          <div class="photo-grid">
            {images.slice(1).map((src, i) => (
              <button type="button" class="photo-thumb" data-index={i + 1}>
                <img src={src} alt={title} loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="lightbox" id="lightbox" hidden>
        <button type="button" class="lightbox-close" id="lightboxClose" aria-label="關閉">✕</button>
        <button type="button" class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="上一張">‹</button>
        <img class="lightbox-img" id="lightboxImg" alt={title} />
        <button type="button" class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="下一張">›</button>
        <div class="lightbox-counter" id="lightboxCounter"></div>
      </div>

      <aside>
        <div class="info-card">
          <h3 style="margin-bottom: 14px;">物件資訊</h3>
          <dl>
            {item.type && <div class="row"><dt>類型</dt><dd>{item.type}</dd></div>}
            {item.address && <div class="row"><dt>地址</dt><dd>{item.address}</dd></div>}
            {item.rooms && <div class="row"><dt>格局</dt><dd>{item.rooms}</dd></div>}
            {!!item.buildingPing && <div class="row"><dt>建物</dt><dd>{item.buildingPing} 坪</dd></div>}
            {!!item.landPing && <div class="row"><dt>土地</dt><dd>{item.landPing} 坪</dd></div>}
            {item.age !== null && <div class="row"><dt>屋齡</dt><dd>{item.age} 年</dd></div>}
            {item.caseNo && <div class="row"><dt>案件編號</dt><dd>{item.caseNo}</dd></div>}
          </dl>
        </div>

        <div class="info-card" style="margin-top: 20px; text-align: center;">
          <p style="margin-bottom: 14px; font-weight: 700;">想看這間房子？</p>
          <p style="margin-bottom: 14px; color: var(--text-soft); font-size: 0.9rem;">
            服務窗口：蔡莎拉<br />
            0986-793-193
          </p>
          <a
            class="btn btn-primary"
            style="width: 100%; justify-content: center; margin-bottom: 10px;"
            href="https://line.me/ti/p/@saLa193"
            target="_blank"
            rel="noopener"
          >
            LINE 預約看屋
          </a>
          <a class="btn btn-outline" style="width: 100%; justify-content: center;" href="tel:0986793193">
            📞 直接來電
          </a>
        </div>

        <div class="info-card license-note" style="margin-top: 20px;">
          <h5>法規揭露</h5>
          {LEGAL_DISCLOSURE.map((store) => (
            <>
              <p class="store-label">{store.storeLabel}</p>
              <p>
                {store.lines.map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))}
              </p>
            </>
          ))}
          <p>{AGENT_LINE}</p>
        </div>

        <a href="/find" class="back-link">← 回待售物件列表</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  const root = document.getElementById('galleryRoot');
  const images = JSON.parse(root?.dataset.images || '[]');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const counter = document.getElementById('lightboxCounter');
  let current = 0;

  function show(index) {
    current = (index + images.length) % images.length;
    lightboxImg.src = images[current];
    counter.textContent = `${current + 1} / ${images.length}`;
  }

  function openLightbox(index) {
    show(index);
    lightbox.hidden = false;
  }

  function closeLightbox() {
    lightbox.hidden = true;
  }

  root?.querySelectorAll('[data-index]').forEach((el) => {
    el.addEventListener('click', () => openLightbox(parseInt(el.dataset.index, 10)));
  });

  document.getElementById('lightboxClose')?.addEventListener('click', closeLightbox);
  document.getElementById('lightboxPrev')?.addEventListener('click', () => show(current - 1));
  document.getElementById('lightboxNext')?.addEventListener('click', () => show(current + 1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  let touchStartX = 0;
  lightbox?.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  });
  lightbox?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) {
      show(dx < 0 ? current + 1 : current - 1);
    }
  });
</script>

<style>
  .no-photo-hero {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    margin-bottom: 20px;
    background: var(--paper-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #B8AD97;
  }
  .price-block {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 20px;
  }
  .price-block .price {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--brick);
  }
  .price-block .price-original {
    font-size: 15px;
    color: var(--text-soft);
    text-decoration: line-through;
  }
  .hero-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .hero-btn .community-cover {
    margin-bottom: 20px;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
    margin-top: 8px;
  }
  .photo-thumb {
    aspect-ratio: 4 / 3;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
  }
  .photo-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #0c0c0c;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    display: block;
    touch-action: pan-y;
  }
  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-close {
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 18px;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 28px;
  }
  .lightbox-prev {
    left: 12px;
  }
  .lightbox-next {
    right: 12px;
  }
  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lightbox-counter {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.85rem;
    background: rgba(255, 255, 255, 0.12);
    padding: 4px 12px;
    border-radius: 999px;
  }
  @media (max-width: 640px) {
    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }
  }
  .license-note h5 {
    font-size: 0.85rem;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .license-note .store-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    margin: 10px 0 2px;
  }
  .license-note p {
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-soft);
    margin: 0;
  }
  .back-link {
    display: inline-block;
    margin-top: 20px;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .back-link:hover {
    color: var(--brick);
  }
</style>
